# Copy to .env and fill in. Never commit a real .env (it is git-ignored).
# Billing provider: "simulated" (default, $0, no account needed) or "stripe" (test mode).
BILLING_PROVIDER=simulated

# App
DATABASE_URL=sqlite:///./metering.db
TENANT_KEY_DEMO=demo-key-123

# Stripe test mode only. Required only when BILLING_PROVIDER=stripe.
# Get these from https://dashboard.stripe.com/test/apikeys (no card needed for test mode).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_

# Dev secret used to sign simulated webhooks (any random string; safe to share).
SIM_WEBHOOK_SECRET=dev-only-sim-secret
